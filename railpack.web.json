{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "steps": {
    "install": {
      "commands": ["pnpm install --frozen-lockfile"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["pnpm run build:web"]
    }
  },
  "deploy": {
    "startCommand": "pnpm --filter @mh/web exec next start --hostname 0.0.0.0 --port $PORT",
    "inputs": [{ "step": "build" }]
  }
}
