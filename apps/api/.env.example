# Copy to .env and adjust for your environment
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3010
# Alias used by some docs / tooling (same as APP_URL)
# APP_BASE_URL=http://localhost:3010
DATABASE_URL=postgresql://muslimhands:muslimhands@127.0.0.1:55432/muslimhands?schema=public
REDIS_URL=redis://127.0.0.1:56379
JWT_ACCESS_SECRET=change-me-access-secret-use-a-long-random-value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-use-a-long-random-value
JWT_REFRESH_EXPIRES_IN=7d
SEED_ADMIN_EMAIL=admin@localhost.local
SEED_ADMIN_PASSWORD=ChangeMeNow!
MAIL_FROM=noreply@localhost
EMAIL_FROM=noreply@localhost
EMAIL_FROM_NAME=Muslim Hands Medicine Distribution System
EMAIL_REPLY_TO=
