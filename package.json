{
  "name": "muslimhands",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:api": "pnpm --filter @mh/shared build && pnpm --filter @mh/api prisma:generate && pnpm --filter @mh/api build",
    "build:web": "pnpm --filter @mh/shared build && pnpm --filter @mh/web build",
    "start": "pnpm run start:web",
    "start:api": "pnpm --filter @mh/api exec prisma migrate deploy && pnpm --filter @mh/api start",
    "start:web": "pnpm --filter @mh/web start",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @mh/api prisma:generate",
    "db:migrate": "pnpm --filter @mh/api prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @mh/api prisma:migrate:deploy",
    "db:seed": "pnpm --filter @mh/api prisma:seed",
    "db:studio": "pnpm --filter @mh/api prisma:studio",
    "db:validate": "pnpm --filter @mh/api prisma:validate"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.6",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  }
}
