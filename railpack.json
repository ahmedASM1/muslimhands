{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "steps": {
    "install": {
      "commands": ["pnpm install --frozen-lockfile"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["pnpm run build:api"]
    }
  },
  "deploy": {
    "startCommand": "pnpm run start:api",
    "inputs": [{ "step": "build" }]
  }
}
