# Application
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# PostgreSQL
POSTGRES_USER=muslimhands
POSTGRES_PASSWORD=muslimhands
POSTGRES_DB=muslimhands
POSTGRES_PORT=55432
DATABASE_URL=postgresql://muslimhands:muslimhands@127.0.0.1:55432/muslimhands?schema=public

# Redis (BullMQ in later phases)
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_URL=redis://127.0.0.1:56379

# JWT — replace with long random secrets before any non-local use
JWT_ACCESS_SECRET=change-me-access-secret-use-a-long-random-value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-use-a-long-random-value
JWT_REFRESH_EXPIRES_IN=7d

# Initial super admin created by prisma seed (local development only)
SEED_ADMIN_EMAIL=admin@localhost.local
SEED_ADMIN_PASSWORD=ChangeMeNow!

# Optional S3-compatible storage (used when file storage is added)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Email provider (optional). When unset, invitation/reset links are logged in development only.
MAIL_FROM=noreply@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
